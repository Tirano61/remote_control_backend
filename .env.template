


#POSTGRES DATA BASE
DATABASE_URL=url.database

JWT_SECRET_KEY=MySupersecretKey_123456

# JWT propio de los dispositivos, obligatorio: sin el la aplicacion no
# arranca. Tiene que ser DISTINTO de JWT_SECRET_KEY, porque compartir el
# secreto haria indistinguibles a nivel de firma el token de un tecnico y el
# de una tablet.
DEVICE_JWT_SECRET=otra_clave_distinta_123456
# Vigencia del Device JWT. Opcional, por defecto 24h.
DEVICE_JWT_EXPIRES_IN=24h

# CORS. Listas de origenes separadas por comas, sin comodines.
# Vacio o ausente: se usan los origenes de desarrollo locales por defecto.
# CORS_ORIGINS es el de la API HTTP.
CORS_ORIGINS=
# SOCKET_IO_CORS_ORIGINS es el del servidor de Socket.IO (namespace
# /technicians, consumido por la Flutter Web del tecnico). Si se deja vacio se
# usan los de CORS_ORIGINS.
SOCKET_IO_CORS_ORIGINS=

# Primer administrador (`npm run bootstrap:admin`). Solo se leen durante esa
# ejecucion: la aplicacion NO las usa al arrancar y no crea ningun usuario sola.
#
# Se recomienda pasarlas en la propia linea de comandos y dejarlas vacias aqui,
# para que la contrasena no quede escrita en ningun fichero. Si se rellenan en
# el `.env` local, conviene borrarlas despues de crear el administrador.
#
# Nunca poner una contrasena real en esta plantilla: `.env.template` si esta en
# git.
#
# La contrasena tiene que cumplir las mismas reglas que `POST /auth/register`
# (6-50 caracteres, con mayuscula, minuscula y numero o simbolo); si no, el
# administrador quedaria creado pero no podria iniciar sesion.
BOOTSTRAP_ADMIN_EMAIL="admin@google.com"
BOOTSTRAP_ADMIN_PASSWORD="Admin213"
BOOTSTRAP_ADMIN_FULL_NAME="Administrador"

# Reset de la contrasena de un administrador YA existente
# (`npm run reset:admin-password`). Igual que las anteriores, solo se leen
# durante esa ejecucion: la aplicacion NO las usa al arrancar.
#
# Son variables APARTE de BOOTSTRAP_ADMIN_* a proposito. Aquellas suelen quedar
# escritas en el `.env` de un despliegue; si el reset las reutilizara, ejecutarlo
# sin argumentos volveria a poner en produccion, en silencio, la contrasena
# antigua.
#
# Operacion administrativa de consola: no existe ningun endpoint equivalente.
# Conviene pasarlas en la propia linea de comandos y dejarlas vacias aqui:
#
#   $env:RESET_ADMIN_EMAIL="admin@example.com"
#   $env:RESET_ADMIN_PASSWORD="<nueva-password>"
#   npm run reset:admin-password
#
# La contrasena nueva tiene que cumplir las mismas reglas que `POST /auth/login`
# (6-50 caracteres, con mayuscula, minuscula y numero o simbolo).
RESET_ADMIN_EMAIL=
RESET_ADMIN_PASSWORD=
